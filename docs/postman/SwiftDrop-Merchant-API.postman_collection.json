    {
      "name": "Machine API negative cases",
      "item": [
        {
          "name": "Missing API key returns 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/merchant-api/orders?page=0&size=20"
          },
          "description": "",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"missing API key returns 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"error code is INVALID_API_KEY\", () => pm.expect(pm.response.json().code).to.eql(\"INVALID_API_KEY\"));"
                ]
              }
            }
          ]
        },
        {
