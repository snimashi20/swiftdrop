    {
      "name": "Rejection workflow",
      "item": [
        {
          "name": "Register a separate merchant for rejection",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/merchants/register",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{rejectedMerchantEmail}}\",\"password\":\"{{demoPassword}}\",\"businessName\":\"Postman Rejection {{rejectedRegistrationNumber}}\",\"registrationNumber\":\"{{rejectedRegistrationNumber}}\",\"contactName\":\"Postman Rejection Owner\",\"contactPhone\":\"0712345679\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString() + Math.floor(Math.random() * 100000).toString().padStart(5, \"0\");",
                  "pm.environment.set(\"rejectedMerchantEmail\", `postman-reject-${suffix}@example.test`);",
                  "pm.environment.set(\"rejectedRegistrationNumber\", `PR-${suffix}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"rejection test merchant registers with 201\", () => pm.response.to.have.status(201));",
                  "var data = pm.response.json();",
                  "if (data.id) pm.environment.set(\"rejectedMerchantId\", data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Rejection test merchant login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{rejectedMerchantEmail}}\",\"password\":\"{{demoPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"rejection test merchant login returns 200\", () => pm.response.to.have.status(200));",
                  "var data = pm.response.json();",
                  "if (data.token) pm.environment.set(\"rejectedMerchantToken\", data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin rejects merchant with a reason",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/admin/merchants/{{rejectedMerchantId}}/reject",
            "body": {
              "mode": "raw",
              "raw": "{\"reason\":\"Postman rejection workflow test\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"rejection returns 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"merchant status is rejected\", () => pm.expect(pm.response.json().status).to.eql(\"REJECTED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Rejected merchant cannot generate an API key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{rejectedMerchantToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/merchants/me/api-keys",
            "body": {
              "mode": "raw",
              "raw": "{\"label\":\"Should be denied\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"rejected merchant key generation returns 403\", () => pm.response.to.have.status(403));",
                  "pm.test(\"error identifies unapproved merchant\", () => pm.expect(pm.response.json().code).to.eql(\"MERCHANT_NOT_APPROVED\"));"
                ]
              }
            }
          ]
        }
      ]
    }
