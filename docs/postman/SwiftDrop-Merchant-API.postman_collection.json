    {
      "name": "Machine orders and merchant dashboard",
      "item": [
        {
          "name": "Create single merchant order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{singleOrderKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/merchant-api/orders",
            "body": {
              "mode": "raw",
              "raw": "{\"pickup\":{\"line1\":\"10 Main Street\",\"city\":\"Colombo\",\"district\":\"Colombo\"},\"dropoff\":{\"line1\":\"20 Lake Road\",\"city\":\"Kandy\",\"district\":\"Kandy\"},\"receiverName\":\"Postman Receiver\",\"receiverPhone\":\"0771234567\",\"size\":\"M\",\"weightKg\":2.0,\"externalOrderId\":\"{{singleExternalOrderId}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString() + Math.floor(Math.random() * 100000).toString().padStart(5, \"0\");",
                  "pm.environment.set(\"singleOrderKey\", `single-${suffix}`);",
                  "pm.environment.set(\"singleExternalOrderId\", `WEB-${suffix}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"new order returns 201\", () => pm.response.to.have.status(201));",
                  "var data = pm.response.json();",
                  "pm.test(\"response includes tracking number and status\", () => { pm.expect(data.trackingNumber).to.be.a(\"string\").and.not.empty; pm.expect(data.status).to.be.a(\"string\"); });",
                  "if (data.trackingNumber) pm.environment.set(\"trackingNumber\", data.trackingNumber);"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry the same order with the same idempotency key and body",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{singleOrderKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/merchant-api/orders",
            "body": {
              "mode": "raw",
              "raw": "{\"pickup\":{\"line1\":\"10 Main Street\",\"city\":\"Colombo\",\"district\":\"Colombo\"},\"dropoff\":{\"line1\":\"20 Lake Road\",\"city\":\"Kandy\",\"district\":\"Kandy\"},\"receiverName\":\"Postman Receiver\",\"receiverPhone\":\"0771234567\",\"size\":\"M\",\"weightKg\":2.0,\"externalOrderId\":\"{{singleExternalOrderId}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"idempotent retry returns 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"retry returns original tracking number\", () => pm.expect(pm.response.json().trackingNumber).to.eql(pm.environment.get(\"trackingNumber\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a fresh bulk batch (up to 50 orders)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{bulkOrderKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/merchant-api/orders/bulk",
            "body": {
              "mode": "raw",
              "raw": "[{\"pickup\":{\"line1\":\"10 Main Street\",\"city\":\"Colombo\",\"district\":\"Colombo\"},\"dropoff\":{\"line1\":\"20 Lake Road\",\"city\":\"Kandy\",\"district\":\"Kandy\"},\"receiverName\":\"Bulk Receiver One\",\"receiverPhone\":\"0771234567\",\"size\":\"S\",\"weightKg\":1.0,\"externalOrderId\":\"BULK-{{bulkExternalSuffix}}-1\"},{\"pickup\":{\"line1\":\"10 Main Street\",\"city\":\"Colombo\",\"district\":\"Colombo\"},\"dropoff\":{\"line1\":\"20 Lake Road\",\"city\":\"Kandy\",\"district\":\"Kandy\"},\"receiverName\":\"Bulk Receiver Two\",\"receiverPhone\":\"0771234568\",\"size\":\"M\",\"weightKg\":2.0,\"externalOrderId\":\"BULK-{{bulkExternalSuffix}}-2\"}]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString() + Math.floor(Math.random() * 100000).toString().padStart(5, \"0\");",
                  "pm.environment.set(\"bulkOrderKey\", `bulk-${suffix}`);",
                  "pm.environment.set(\"bulkExternalSuffix\", suffix);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"new bulk batch returns 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"two order responses are returned\", () => pm.expect(pm.response.json()).to.have.length(2));"
                ]
              }
            }
          ]
        },
        {
