          "description": "",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"revocation returns 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"key is inactive\", () => pm.expect(pm.response.json().active).to.eql(false));"
                ]
              }
            }
          ]
        }
      ]
