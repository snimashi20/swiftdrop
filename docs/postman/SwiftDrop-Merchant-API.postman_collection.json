{
  "info": {
    "name": "SwiftDrop Merchant API",
    "description": "Repeatable M9 merchant workflow. Run sequentially with the matching local environment. Passwords, JWTs, and API keys are never stored in this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication and seeded accounts",
      "item": [
        {
          "name": "Admin login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{demoPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"admin login returns 200\", () => pm.response.to.have.status(200));",
                  "var data = pm.response.json();",
                  "pm.test(\"login response includes a JWT\", () => pm.expect(data.token).to.be.a(\"string\").and.not.empty);",
                  "pm.test(\"login response includes admin role\", () => pm.expect(JSON.stringify(data.roles)).to.match(/ADMIN/));",
                  "if (data.token) pm.environment.set(\"adminToken\", data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Seeded approved merchant login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{merchantEmail}}\",\"password\":\"{{demoPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"merchant login returns 200\", () => pm.response.to.have.status(200));",
                  "var data = pm.response.json();",
                  "pm.test(\"login response includes a JWT\", () => pm.expect(data.token).to.be.a(\"string\").and.not.empty);",
                  "pm.test(\"login response includes merchant role\", () => pm.expect(JSON.stringify(data.roles)).to.match(/MERCHANT/));",
                  "if (data.token) pm.environment.set(\"merchantToken\", data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Generate API key for seeded merchant (for cross-merchant check)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{merchantToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/merchants/me/api-keys",
            "body": {
              "mode": "raw",
              "raw": "{\"label\":\"Postman ownership check\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"key generation returns 201\", () => pm.response.to.have.status(201));",
                  "var data = pm.response.json();",
                  "pm.test(\"raw API key is returned once\", () => pm.expect(data.apiKey).to.be.a(\"string\").and.not.empty);",
                  "if (data.apiKey) pm.environment.set(\"seedApiKey\", data.apiKey);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Register and review merchants",
      "item": [
        {
          "name": "Register unique merchant for approval",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/merchants/register",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{newMerchantEmail}}\",\"password\":\"{{demoPassword}}\",\"businessName\":\"Postman Approval {{newRegistrationNumber}}\",\"registrationNumber\":\"{{newRegistrationNumber}}\",\"contactName\":\"Postman Owner\",\"contactPhone\":\"0712345678\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString() + Math.floor(Math.random() * 100000).toString().padStart(5, \"0\");",
                  "pm.environment.set(\"newMerchantEmail\", `postman-${suffix}@example.test`);",
                  "pm.environment.set(\"newRegistrationNumber\", `PM-${suffix}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"registration returns 201\", () => pm.response.to.have.status(201));",
                  "var data = pm.response.json();",
                  "pm.test(\"new merchant starts pending\", () => pm.expect(data.status).to.eql(\"PENDING\"));",
                  "if (data.id) pm.environment.set(\"merchantId\", data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "New pending merchant login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{newMerchantEmail}}\",\"password\":\"{{demoPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"pending merchant login returns 200\", () => pm.response.to.have.status(200));",
                  "var data = pm.response.json();",
                  "if (data.token) pm.environment.set(\"pendingMerchantToken\", data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Pending merchant cannot generate an API key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pendingMerchantToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/merchants/me/api-keys",
            "body": {
              "mode": "raw",
              "raw": "{\"label\":\"Should be denied\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"pending merchant key generation returns 403\", () => pm.response.to.have.status(403));",
                  "pm.test(\"error identifies unapproved merchant\", () => pm.expect(pm.response.json().code).to.eql(\"MERCHANT_NOT_APPROVED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin lists pending merchants",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/admin/merchants?status=PENDING&page=0&size=20"
          },
          "description": "",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"admin list returns 200\", () => pm.response.to.have.status(200));",
                  "var data = pm.response.json();",
                  "pm.test(\"registered merchant is in pending results\", () => pm.expect(data.content.some((merchant) => String(merchant.id) === String(pm.environment.get(\"merchantId\")))).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Merchant token cannot access admin endpoints",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{merchantToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/admin/merchants"
          },
          "description": "",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"non-admin access returns 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unauthenticated admin access is rejected",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/admin/merchants"
          },
          "description": "",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"missing JWT returns 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin approves new merchant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/admin/merchants/{{merchantId}}/approve"
          },
          "description": "",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"approval returns 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"merchant status is approved\", () => pm.expect(pm.response.json().status).to.eql(\"APPROVED\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Merchant API-key management",
      "item": [
        {
          "name": "Approved merchant generates machine API key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pendingMerchantToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/merchants/me/api-keys",
            "body": {
              "mode": "raw",
              "raw": "{\"label\":\"Postman order integration\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"key generation returns 201\", () => pm.response.to.have.status(201));",
                  "var data = pm.response.json();",
                  "pm.test(\"generated key response includes a raw key\", () => pm.expect(data.apiKey).to.be.a(\"string\").and.not.empty);",
                  "if (data.apiKey) pm.environment.set(\"apiKey\", data.apiKey);",
                  "if (data.id) pm.environment.set(\"apiKeyId\", data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Merchant lists keys without raw secrets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pendingMerchantToken}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/merchants/me/api-keys"
          },
          "description": "",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"key list returns 200\", () => pm.response.to.have.status(200));",
                  "var data = pm.response.json();",
                  "pm.test(\"key list contains the generated key\", () => pm.expect(data.some((key) => String(key.id) === String(pm.environment.get(\"apiKeyId\")))).to.eql(true));",
                  "pm.test(\"key list does not expose raw keys or hashes\", () => pm.expect(JSON.stringify(data)).not.to.match(/\"apiKey\"|\"keyHash\"/));"
                ]
              }
            }
          ]
        },
        {
          "name": "Generate a separate key for revocation test",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{pendingMerchantToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/merchants/me/api-keys",
            "body": {
              "mode": "raw",
              "raw": "{\"label\":\"Postman revocation test\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"second key generation returns 201\", () => pm.response.to.have.status(201));",
                  "var data = pm.response.json();",
                  "if (data.apiKey) pm.environment.set(\"revokedApiKey\", data.apiKey);",
                  "if (data.id) pm.environment.set(\"revokedKeyId\", data.id);"
