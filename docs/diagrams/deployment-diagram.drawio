        <mxCell id="sec1-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="110" width="1540" height="110" as="geometry" />
        </mxCell>
        <mxCell id="sec1-title" value="EXTERNAL CLIENTS &amp; CONSUMERS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontFamily=Helvetica;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="335" y="115" width="300" height="20" as="geometry" />
        </mxCell>

        <!-- Actor: Browser Users -->
        <mxCell id="act-users" value="&lt;b&gt;Web Users&lt;/b&gt;&lt;br/&gt;Customer · Courier · Dispatcher · Admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1E3A5F;fontFamily=Helvetica;fontSize=11;fontColor=#1E3A5F;" vertex="1" parent="1">
          <mxGeometry x="350" y="145" width="250" height="55" as="geometry" />
        </mxCell>

        <!-- Actor: Merchant Online Store -->
        <mxCell id="act-merchant" value="&lt;b&gt;Merchant E-Commerce Store&lt;/b&gt;&lt;br/&gt;Sends Orders (API Key) / Receives Webhooks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1E3A5F;fontFamily=Helvetica;fontSize=11;fontColor=#1E3A5F;" vertex="1" parent="1">
