# SwiftDrop - environment variables
# Copy to .env and use these values as-is for local development.
# NEVER commit .env — it is git-ignored.
#
#   cp .env.example .env
#   docker compose up

# ---------- Database (PostgreSQL 16) ----------
POSTGRES_DB=swiftdrop
POSTGRES_USER=swiftdrop
POSTGRES_PASSWORD=swiftdrop
DB_URL=jdbc:postgresql://localhost:5432/swiftdrop
DB_USERNAME=swiftdrop
DB_PASSWORD=swiftdrop

# ---------- RabbitMQ ----------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_MANAGEMENT_PORT=15672

# ---------- JWT / security (M8 — Dinira) ----------
# Dev-only secret — NEVER use this in production
JWT_SECRET=swiftdrop-dev-secret-key-change-me-in-production-min-32-chars!!
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ---------- Google OAuth 2.0 (M2 — Sadeepa) ----------
# Get these from Sadeepa privately — NEVER commit real values
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# ---------- Mail / Mailpit (M1 — Sithmi) ----------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@swiftdrop.local
MAILPIT_UI_PORT=8025

# ---------- Service URLs and ports ----------
CORE_API_PORT=8080
NOTIFICATION_SERVICE_PORT=8081
MOCK_MERCHANT_STORE_PORT=8082
AI_ASSISTANT_PORT=8083
FRONTEND_PORT=3000
CORE_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_BASE_URL=ws://localhost:8080/ws
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------- Webhooks (M10 — Sandavi) ----------
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_DELAYS_SECONDS=10,30,120
WEBHOOK_SIGNATURE_HEADER=X-SwiftDrop-Signature

# ---------- File uploads (M7 — Pamithra) ----------
UPLOAD_DIR=./uploads
UPLOAD_MAX_FILE_SIZE_MB=5

# ---------- Pricing (M4 — Naviru) ----------
PRICING_STRATEGY=standard

# ---------- AI assistant bonus (M4 — Naviru) ----------
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL=gemini-2.0-flash
