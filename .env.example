# SwiftDrop - environment variables
#
# NEVER put real credentials in this file. It is tracked by git and this repo is public.
# Real values go in your own .env, which is git-ignored.

# ---------- Option A: shared team database (Supabase) ----------
# Ask Sithmi for the host, username and password, then paste them into your .env.
# Runtime traffic uses the transaction pooler (port 6543) and needs prepareThreshold=0.
# Flyway migrations must NOT go through the transaction pooler - see DB_MIGRATION_URL below.
#DB_URL=jdbc:postgresql://<pooler-host>:6543/postgres?sslmode=require&prepareThreshold=0
#DB_USERNAME=postgres.<project-ref>
#DB_PASSWORD=<ask-sithmi>
# Same host, session pooler port 5432. Flyway holds a session-level advisory lock while it
# migrates, and a transaction pooler does not keep a statement on the same backend, so two
# people starting up at once could migrate concurrently through 6543.
# Set this whenever you set DB_URL above - both or neither. If you set only DB_URL, Flyway
# migrates the local postgres container while the app talks to the cloud.
#DB_MIGRATION_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
# Connection pool sizes per service (optional overrides, defaults: core-api=3, notification-service=2)
#CORE_API_DB_POOL_SIZE=3
#NOTIFICATION_DB_POOL_SIZE=2

# ---------- Option B: local Docker PostgreSQL (default, works offline) ----------
# Leave Option A commented out and these three are all you need; docker-compose.yml
# falls back to the local postgres container.
POSTGRES_DB=swiftdrop
POSTGRES_USER=swiftdrop
POSTGRES_PASSWORD=swiftdrop_pass
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_MANAGEMENT_PORT=15672
JWT_SECRET=your-jwt-secret-key-here-min-32-bytes-long
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@swiftdrop.lk
MAILPIT_UI_PORT=8025
CORE_API_PORT=8080
NOTIFICATION_SERVICE_PORT=8081
MOCK_MERCHANT_STORE_PORT=8085
AI_ASSISTANT_PORT=8082
FRONTEND_PORT=3000
CORE_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=ws://localhost:8080/ws
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_DELAYS_SECONDS=10,30,120
WEBHOOK_SIGNATURE_HEADER=X-SwiftDrop-Signature

# ---------- File uploads (M7 — Pamithra) ----------
UPLOAD_DIR=./uploads
UPLOAD_MAX_FILE_SIZE_MB=5

# ---------- Pricing (M4) ----------
PRICING_STRATEGY=STANDARD

# ---------- AI assistant bonus (M4) ----------
AI_PROVIDER=mock
GEMINI_API_KEY=
