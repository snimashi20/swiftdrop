# SwiftDrop - environment variables
# Copy to .env and fill in real values. NEVER commit .env.
# Every variable the services read must be listed here (names only, no secrets).

# ---------- Database (PostgreSQL 16) ----------
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# ---------- RabbitMQ ----------
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_MANAGEMENT_PORT=

# ---------- JWT / security (M8) ----------
JWT_SECRET=
JWT_EXPIRATION_MS=
JWT_REFRESH_EXPIRATION_MS=

# ---------- Google OAuth 2.0 (M2) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---------- Mail / Mailpit (M1) ----------
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAILPIT_UI_PORT=

# ---------- Service URLs and ports ----------
CORE_API_PORT=
NOTIFICATION_SERVICE_PORT=
MOCK_MERCHANT_STORE_PORT=
AI_ASSISTANT_PORT=
FRONTEND_PORT=
CORE_API_BASE_URL=
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
CORS_ALLOWED_ORIGINS=

# ---------- Webhooks (M10) ----------
WEBHOOK_MAX_ATTEMPTS=
WEBHOOK_RETRY_DELAYS_SECONDS=
WEBHOOK_SIGNATURE_HEADER=

# ---------- File uploads (M7) ----------
UPLOAD_DIR=
UPLOAD_MAX_FILE_SIZE_MB=

# ---------- Pricing (M4) ----------
PRICING_STRATEGY=

# ---------- AI assistant bonus (M4) ----------
AI_PROVIDER=
GEMINI_API_KEY=
OLLAMA_BASE_URL=
AI_MODEL=
