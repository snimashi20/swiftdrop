# SwiftDrop - environment variables
POSTGRES_DB=swiftdrop
POSTGRES_USER=swiftdrop
POSTGRES_PASSWORD=swiftdrop_pass
DB_URL=jdbc:postgresql://postgres:5432/swiftdrop
DB_USERNAME=swiftdrop
DB_PASSWORD=swiftdrop_pass
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_MANAGEMENT_PORT=15672
JWT_SECRET=your-jwt-secret-key-here-min-32-bytes-long
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@swiftdrop.lk
MAILPIT_UI_PORT=8025
CORE_API_PORT=8080
NOTIFICATION_SERVICE_PORT=8081
MOCK_MERCHANT_STORE_PORT=8085
AI_ASSISTANT_PORT=8082
FRONTEND_PORT=3000
CORE_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=ws://localhost:8080/ws
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_DELAYS_SECONDS=10,30,120
WEBHOOK_SIGNATURE_HEADER=X-SwiftDrop-Signature

# ---------- File uploads (M7 — Pamithra) ----------
UPLOAD_DIR=./uploads
UPLOAD_MAX_FILE_SIZE_MB=5

# ---------- Pricing (M4) ----------
PRICING_STRATEGY=STANDARD

# ---------- AI assistant bonus (M4) ----------
AI_PROVIDER=mock
GEMINI_API_KEY=
